export type IconName = keyof typeof solid | keyof typeof stroke;
interface Props { name: IconName }
const { name } = Astro.props;
const d = (solid as Record<string, string>)[name];
---
{d ? (
  <span class="icon"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={d} /></svg></span>
) : (
  <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={(stroke as Record<string, string>)[name]} /></span>
)}
