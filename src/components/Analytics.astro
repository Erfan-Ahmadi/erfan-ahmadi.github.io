---
// Umami (cloud.umami.is): cookieless page views with their referrer, UTM tags, country and device, plus
// the events below and in src/lib/analytics.ts. Loaded only in the built site and counted only on the
// real domain, so `npm run dev` and `npm run preview` don't add visits.
import { SITE } from '../site';

const { src, websiteId } = SITE.umami;
const domain = new URL(SITE.url).hostname;
---
{import.meta.env.PROD && websiteId && (
  <>
    <script is:inline>
      // One page load is one view: the home page's year filter rewrites the query with
      // history.replaceState, which Umami would count as another view of the same page.
      // Visits through an old URL (src/redirects.mjs, see src/integrations/redirect-html.mjs) keep the
      // site that linked to it as their referrer, and send old-url with the path they used.
      (() => {
        let redirect, lastPath;
        try {
          redirect = JSON.parse(sessionStorage.getItem('redirected-from'));
          sessionStorage.removeItem('redirected-from');
        } catch {}
        window.umamiBeforeSend = (type, payload) => {
          if (type !== 'event' || payload.name) return payload;
          const path = new URL(payload.url, location.href).pathname;
          if (path === lastPath) return null;
          if (!lastPath && redirect) {
            payload.referrer = redirect.referrer;
            setTimeout(() => window.umami.track('old-url', { from: redirect.from }));
          }
          lastPath = path;
          return payload;
        };
      })();
    </script>
    <script async src={src} data-website-id={websiteId} data-domains={domain} data-before-send="umamiBeforeSend"></script>
  </>
)}

<script>
  import { track } from '../lib/analytics';

  // A click on an element marked data-track="event-name" sends that event, with its
  // data-track-<property>="value" attributes as properties. Any other link off the site sends
  // outbound-click. Links aren't held up: the tracker sends with fetch's keepalive.
  const onClick = (event: MouseEvent) => {
    if (event.type === 'auxclick' && event.button !== 1) return; // middle click opens a tab
    const target = event.target as Element;
    const marked = target.closest<HTMLElement>('[data-track]');
    if (marked) {
      const data: Record<string, string> = {};
      for (const { name, value } of marked.attributes) {
        if (name.startsWith('data-track-')) data[name.slice('data-track-'.length)] = value;
      }
      track(marked.dataset.track!, data);
      return;
    }
    const link = target.closest<HTMLAnchorElement>('a[href]');
    if (link && /^https?:$/.test(link.protocol) && link.host !== location.host) {
      track('outbound-click', { domain: link.hostname, url: link.href });
    }
  };
  document.addEventListener('click', onClick, true);
  document.addEventListener('auxclick', onClick, true);
</script>
