---
// Click-to-play YouTube embed: shows our own copy of the thumbnail (src/lib/youtube.ts)
// and only contacts YouTube, loading its player and cookies, once the reader presses play.
import { Image } from 'astro:assets';
import { youtubeThumbnail } from '../lib/youtube';

interface Props {
  id: string;
  title?: string;
}
const { id, title = 'Play video' } = Astro.props;
const thumbnail = youtubeThumbnail(id);
---
<div class="yt" data-yt-id={id}>
  <a class="yt-poster" href={`https://www.youtube.com/watch?v=${id}`} aria-label={title} data-track="video-play" data-track-video={id}>
    {thumbnail && <Image src={thumbnail} alt="" widths={[640, 1280, 1920]} sizes="(max-width: 760px) 100vw, 1100px" />}
    <span class="yt-play" aria-hidden="true">
      <svg viewBox="0 0 68 48"><rect width="68" height="48" rx="12" fill="#FF0033" /><path d="M27 14v20l18-10z" fill="#fff" /></svg>
    </span>
  </a>
</div>

<style>
  .yt { position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; border: 1px solid var(--line); background: radial-gradient(120% 90% at 70% 20%, #3a2a24, #121110 70%); }
  .yt-poster { position: absolute; inset: 0; display: grid; place-items: center; }
  .yt-poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .yt-play { position: relative; width: 76px; transition: transform 0.2s ease; filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.35)); }
  .yt-poster:hover .yt-play { transform: scale(1.08); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    el.querySelector('a')?.addEventListener('click', (event) => {
      event.preventDefault();
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.ytId}?autoplay=1&rel=0`;
      iframe.title = 'YouTube video player';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>
