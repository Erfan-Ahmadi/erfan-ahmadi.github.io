---
import Cover from './Cover.astro';
import PostMeta from './PostMeta.astro';
import { postUrl, yearOf, type Post } from '../lib/posts';

interface Props { post: Post }
const { post } = Astro.props;
const { title, description, series, part, youtube } = post.data;
const tags = youtube ? ['YouTube', ...post.data.tags] : post.data.tags;
const year = yearOf(post);
const haystack = [title, description, ...tags, youtube ? 'video' : '', series ?? '', year].join(' ').toLowerCase();
---
<a class="card" href={postUrl(post)} data-year={year} data-search={haystack}>
  <Cover post={post} sizes="(max-width: 760px) calc(100vw - 36px), (max-width: 1040px) 45vw, 360px" />
  {series ? <div class="series">{series}{part && <> &middot; Part {part}</>}</div> : <PostMeta post={post} />}
  <h3>{title}</h3>
  <p>{description}</p>
  {series ? <PostMeta post={post} /> : <div class="tags">{tags.join(' · ')}</div>}
</a>
